# Supabase dashboard > Connect > "Session pooler" connection string (port 5432).
# Replace [YOUR-PASSWORD] with your database password (Project Settings > Database).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
ADMIN_EMAIL=
PORT=3000
# Set to 1 when running behind a proxy/host that terminates HTTPS (Render, Railway, Fly, nginx...)
TRUST_PROXY=
